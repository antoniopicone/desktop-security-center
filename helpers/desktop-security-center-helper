#!/usr/bin/env python3
"""Single pkexec entry point for privileged actions (spec §5).

Never invoked interactively as root by the app itself — always launched
as ``pkexec .../desktop-security-center-helper <subcommand>``. All logic
lives in helper_core.py so it can be unit tested without privileges.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from helper_core import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
